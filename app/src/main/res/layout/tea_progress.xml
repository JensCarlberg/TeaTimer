<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/teaTimerProgressLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            >
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/teaTimerProgress"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:max="10000"
                app:indicatorColor="@color/colorPrimary"
                app:indicatorSize="250dp"
                app:trackColor="#ddd"
                app:trackCornerRadius="10dp"
                app:trackThickness="20dp"
                tools:progress="6000" />
            <ImageView
                android:id="@+id/teaTimerProgressDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_delete_forever_48"
                android:layout_alignEnd="@id/teaTimerProgress"
                android:contentDescription="@string/remove_timer" />
            <TextView
                android:id="@+id/teaTimerProgressText"
                android:layout_alignStart="@id/teaTimerProgress"
                android:layout_alignEnd="@id/teaTimerProgress"
                android:layout_alignTop="@id/teaTimerProgress"
                android:layout_alignBottom="@id/teaTimerProgress"
                android:background="@android:color/transparent"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:textSize="60sp"
                android:textStyle="bold"
                tools:text="1:23" />
        </RelativeLayout>
        <TextView
            android:id="@+id/teaTimerTeaText"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="Rooibos\nTermos 1" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/teaTimerTextRowLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp"
        android:padding="5dp"
        android:fadingEdge="horizontal"
        android:visibility="visible"
        >

        <Space
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:alpha="0.5" />

        <LinearLayout
            android:id="@+id/timer_container"
            android:background="#ffeeeeee"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/teaPot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|start"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold"
                android:layout_weight="0.8"
                tools:text="Rooibos\nTermos 1" />

            <Button
                android:id="@+id/teaTimerDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold"
                android:layout_weight="0.2"
                android:layout_gravity="center|end"
                tools:text="..." />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:alpha="0.5" />

    </LinearLayout>
</LinearLayout>
